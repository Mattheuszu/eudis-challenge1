<?xml version="1.0" ?>
<!--
  Demo world: Baylands park + START helipad at the spawn point + target "B".
  Gazebo frame is ENU: x = East, y = North. PX4 local frame is NED (North = y here).
  Install into PX4 with sim/install_world.sh, run with:
    PX4_GZ_WORLD=demo make px4_sitl gz_x500
  If you move B, update B_NORTH / B_EAST in demo_control.py.
-->
<sdf version='1.9'>
  <world name='demo'>
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <ambient>0.8 0.8 0.8 1</ambient>
      <background>0.6 0.75 0.9 1</background>
      <grid>false</grid>
      <sky>
        <clouds>true</clouds>
      </sky>
      <shadows>1</shadows>
    </scene>
    <light name='sunUTC' type='directional'>
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>false</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/baylands</uri>
      <name>park</name>
      <pose>205 155 -1 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Coast Water</uri>
      <pose>0 0 -2 0 0 0
        <relative_to>park</relative_to>
      </pose>
    </include>

    <!-- START: helipad under the drone spawn point + green pole -->
    <include>
      <uri>model://helipad</uri>
      <name>start_pad</name>
      <pose>0 0 0.03 0 0 0</pose>
    </include>
    <model name='start_marker'>
      <static>true</static>
      <pose>0 -3.5 0 0 0 0</pose>
      <link name='link'>
        <visual name='pole'>
          <pose>0 0 2 0 0 0</pose>
          <geometry><cylinder><radius>0.08</radius><length>4</length></cylinder></geometry>
          <material><diffuse>0.9 0.9 0.9 1</diffuse><ambient>0.9 0.9 0.9 1</ambient></material>
        </visual>
        <visual name='flag'>
          <pose>0.45 0 3.6 0 0 0</pose>
          <geometry><box><size>0.8 0.04 0.5</size></box></geometry>
          <material><diffuse>0.1 0.8 0.2 1</diffuse><ambient>0.1 0.8 0.2 1</ambient><emissive>0.05 0.4 0.1 1</emissive></material>
        </visual>
      </link>
    </model>

    <!-- B: red landing circle + tall red/white pole with a ball, visible from START -->
    <model name='point_b'>
      <static>true</static>
      <pose>25 20 0 0 0 0</pose>
      <link name='link'>
        <visual name='pad'>
          <pose>0 0 0.05 0 0 0</pose>
          <geometry><cylinder><radius>2.5</radius><length>0.1</length></cylinder></geometry>
          <material><diffuse>0.85 0.1 0.1 1</diffuse><ambient>0.85 0.1 0.1 1</ambient></material>
        </visual>
        <visual name='pad_inner'>
          <pose>0 0 0.06 0 0 0</pose>
          <geometry><cylinder><radius>1.5</radius><length>0.1</length></cylinder></geometry>
          <material><diffuse>1 1 1 1</diffuse><ambient>1 1 1 1</ambient></material>
        </visual>
        <visual name='pole_low'>
          <pose>0 0 1.5 0 0 0</pose>
          <geometry><cylinder><radius>0.1</radius><length>3</length></cylinder></geometry>
          <material><diffuse>0.9 0.1 0.1 1</diffuse><ambient>0.9 0.1 0.1 1</ambient></material>
        </visual>
        <visual name='pole_high'>
          <pose>0 0 4.5 0 0 0</pose>
          <geometry><cylinder><radius>0.1</radius><length>3</length></cylinder></geometry>
          <material><diffuse>1 1 1 1</diffuse><ambient>1 1 1 1</ambient></material>
        </visual>
        <visual name='ball'>
          <pose>0 0 6.3 0 0 0</pose>
          <geometry><sphere><radius>0.5</radius></sphere></geometry>
          <material><diffuse>1 0.15 0.1 1</diffuse><ambient>1 0.15 0.1 1</ambient><emissive>0.6 0.05 0.02 1</emissive></material>
        </visual>
      </link>
    </model>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>37.412173071650805</latitude_deg>
      <longitude_deg>-121.998878727967</longitude_deg>
      <elevation>38</elevation>
    </spherical_coordinates>
  </world>
</sdf>
