<?xml version="1.0" ?>
<!--
  "base" world: forward operating base at START, battlefield in between, enemy facility = target.
  Gazebo frame is ENU: x = East, y = North (metres). PX4 local frame is NED.
  Install: bash sim/install_world.sh   Run: bash sim/start_swarm.sh  (3 drones)
           or: cd ~/PX4-Autopilot && PX4_GZ_WORLD=base make px4_sitl gz_x500  (1 drone)
  Keep TARGET / JAMMER / pads in sync with demo_control.py (SCENE settings).
-->
<sdf version='1.9'>
  <world name='base'>
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <ambient>0.75 0.75 0.75 1</ambient>
      <background>0.62 0.7 0.78 1</background>
      <grid>false</grid>
      <sky><clouds>true</clouds></sky>
      <shadows>1</shadows>
    </scene>
    <light name='sunUTC' type='directional'>
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.3 0.5 -0.8</direction>
      <diffuse>0.95 0.92 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation><range>2000</range><linear>0</linear><constant>1</constant><quadratic>0</quadratic></attenuation>
    </light>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/baylands</uri>
      <name>park</name>
      <pose>47 -72 -1 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Coast Water</uri>
      <pose>0 0 -2 0 0 0<relative_to>park</relative_to></pose>
    </include>

    <!-- ================= FORWARD OPERATING BASE (around START) ================= -->
    <!-- launch platform: one raised deck (top at 0.86 m) with three numbered-free H pads at N 0/+6/-6 -->
    <model name='launch_platform'><static>true</static><pose>0 0 0 0 0 0</pose><link name='link'><visual name='slab'><pose>0.000 0.000 0.000 0 0 0</pose><geometry><box><size>5.200 18.400 1.600</size></box></geometry><material><diffuse>0.20 0.22 0.20 1</diffuse><ambient>0.20 0.22 0.20 1</ambient></material></visual><collision name='slab_c'><pose>0.000 0.000 0.000 0 0 0</pose><geometry><box><size>5.200 18.400 1.600</size></box></geometry></collision><visual name='deck'><pose>0.000 0.000 0.815 0 0 0</pose><geometry><box><size>5.000 18.200 0.030</size></box></geometry><material><diffuse>0.36 0.37 0.36 1</diffuse><ambient>0.36 0.37 0.36 1</ambient></material></visual><visual name='rim_e'><pose>2.550 0.000 0.840 0 0 0</pose><geometry><box><size>0.100 18.400 0.080</size></box></geometry><material><diffuse>0.95 0.75 0.10 1</diffuse><ambient>0.95 0.75 0.10 1</ambient></material></visual><visual name='rim_w'><pose>-2.550 0.000 0.840 0 0 0</pose><geometry><box><size>0.100 18.400 0.080</size></box></geometry><material><diffuse>0.95 0.75 0.10 1</diffuse><ambient>0.95 0.75 0.10 1</ambient></material></visual><visual name='pad1'><pose>0.000 0.000 0.835 0 0 0</pose><geometry><box><size>3.800 3.800 0.020</size></box></geometry><material><diffuse>0.13 0.14 0.15 1</diffuse><ambient>0.13 0.14 0.15 1</ambient></material></visual><visual name='h1a'><pose>-0.700 0.000 0.850 0 0 0</pose><geometry><box><size>0.350 2.200 0.010</size></box></geometry><material><diffuse>0.95 0.95 0.95 1</diffuse><ambient>0.95 0.95 0.95 1</ambient></material></visual><visual name='h1b'><pose>0.700 0.000 0.850 0 0 0</pose><geometry><box><size>0.350 2.200 0.010</size></box></geometry><material><diffuse>0.95 0.95 0.95 1</diffuse><ambient>0.95 0.95 0.95 1</ambient></material></visual><visual name='h1c'><pose>0.000 0.000 0.850 0 0 0</pose><geometry><box><size>1.400 0.350 0.010</size></box></geometry><material><diffuse>0.95 0.95 0.95 1</diffuse><ambient>0.95 0.95 0.95 1</ambient></material></visual><visual name='pad2'><pose>0.000 6.000 0.835 0 0 0</pose><geometry><box><size>3.800 3.800 0.020</size></box></geometry><material><diffuse>0.13 0.14 0.15 1</diffuse><ambient>0.13 0.14 0.15 1</ambient></material></visual><visual name='h2a'><pose>-0.700 6.000 0.850 0 0 0</pose><geometry><box><size>0.350 2.200 0.010</size></box></geometry><material><diffuse>0.95 0.95 0.95 1</diffuse><ambient>0.95 0.95 0.95 1</ambient></material></visual><visual name='h2b'><pose>0.700 6.000 0.850 0 0 0</pose><geometry><box><size>0.350 2.200 0.010</size></box></geometry><material><diffuse>0.95 0.95 0.95 1</diffuse><ambient>0.95 0.95 0.95 1</ambient></material></visual><visual name='h2c'><pose>0.000 6.000 0.850 0 0 0</pose><geometry><box><size>1.400 0.350 0.010</size></box></geometry><material><diffuse>0.95 0.95 0.95 1</diffuse><ambient>0.95 0.95 0.95 1</ambient></material></visual><visual name='pad3'><pose>0.000 -6.000 0.835 0 0 0</pose><geometry><box><size>3.800 3.800 0.020</size></box></geometry><material><diffuse>0.13 0.14 0.15 1</diffuse><ambient>0.13 0.14 0.15 1</ambient></material></visual><visual name='h3a'><pose>-0.700 -6.000 0.850 0 0 0</pose><geometry><box><size>0.350 2.200 0.010</size></box></geometry><material><diffuse>0.95 0.95 0.95 1</diffuse><ambient>0.95 0.95 0.95 1</ambient></material></visual><visual name='h3b'><pose>0.700 -6.000 0.850 0 0 0</pose><geometry><box><size>0.350 2.200 0.010</size></box></geometry><material><diffuse>0.95 0.95 0.95 1</diffuse><ambient>0.95 0.95 0.95 1</ambient></material></visual><visual name='h3c'><pose>0.000 -6.000 0.850 0 0 0</pose><geometry><box><size>1.400 0.350 0.010</size></box></geometry><material><diffuse>0.95 0.95 0.95 1</diffuse><ambient>0.95 0.95 0.95 1</ambient></material></visual></link></model>

    <!-- operators' ground station: tent with tables and chairs, antenna, people watching the drones -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/ground_station</uri>
      <name>ground_station</name>
      <pose>-11 2 0 0 0 -1.5708</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/antenna</uri>
      <name>gs_antenna</name>
      <pose>-15 8 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Standing person</uri>
      <name>operator_1</name>
      <pose>-5 3 0 0 0 0</pose><static>true</static>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Casual female</uri>
      <name>operator_2</name>
      <pose>-5.5 -0.5 0 0 0 0.3</pose><static>true</static>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Standing person</uri>
      <name>operator_3</name>
      <pose>-6 -4 0 0 0 0.5</pose><static>true</static>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/tent</uri>
      <name>tent_1</name>
      <pose>-12 -9 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Radio tower</uri>
      <name>radio_tower</name>
      <pose>-20 22 0 0 0 0</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pickup</uri>
      <name>base_pickup</name>
      <pose>-7 -15 0 0 0 0.2</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/TruckBox</uri>
      <name>base_truck</name>
      <pose>-16 -18 0 0 0 1.4</pose>
    </include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Gazebo flag</uri><name>base_flag</name><pose>-3 9 0 0 0 0</pose></include>
    <!-- base perimeter: concrete barriers facing the battlefield, gap for the drones -->
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri><name>wall_1</name><pose>10 -14 0 0 0 1.5708</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri><name>wall_2</name><pose>10 -9 0 0 0 1.5708</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri><name>wall_3</name><pose>10 10 0 0 0 1.5708</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri><name>wall_4</name><pose>10 15 0 0 0 1.5708</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Large Crate</uri><name>supply_1</name><pose>-8 9 0 0 0 0.3</pose><static>true</static></include>

    <!-- ================= BATTLEFIELD ================= -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Collapsed House</uri>
      <name>ruin_house</name>
      <pose>25 25 0 0 0 0.6</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Collapsed police station</uri>
      <name>ruin_police</name>
      <pose>78 -40 0 0 0 -0.4</pose>
    </include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri><name>field_block_1</name><pose>35 12 0 0 0 0.9</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri><name>field_block_2</name><pose>70 -25 0 0 0 0.2</pose></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Large Crate</uri><name>field_crate_1</name><pose>85 12 0 0 0 0.7</pose><static>true</static></include>
    <include><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Large Crate</uri><name>field_crate_2</name><pose>30 -20 0 0 0 1.1</pose><static>true</static></include>

    <!-- enemy GPS jammer: truck + antenna, translucent red dome (radius 20 m) = where GPS dies (visual only, for the audience) -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/TruckBox</uri>
      <name>jammer_truck</name>
      <pose>50 -7 0 0 0 0.8</pose>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/antenna</uri>
      <name>jammer_antenna</name>
      <pose>53 -10 0 0 0 0</pose>
    </include>
    <model name='jammer_zone'>
      <static>true</static>
      <pose>50 -7 0 0 0 0</pose>
      <link name='link'>
        <visual name='dome'>
          <geometry><sphere><radius>20</radius></sphere></geometry>
          <transparency>0.82</transparency>
          <cast_shadows>false</cast_shadows>
          <material><diffuse>1 0.1 0.05 1</diffuse><ambient>1 0.1 0.05 1</ambient><emissive>0.4 0.02 0.0 1</emissive></material>
        </visual>
        <visual name='ring'>
          <pose>0 0 0.15 0 0 0</pose>
          <geometry><cylinder><radius>20</radius><length>0.08</length></cylinder></geometry>
          <transparency>0.6</transparency>
          <material><diffuse>1 0.1 0.05 1</diffuse><ambient>1 0.1 0.05 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- ================= TARGET: enemy facility ================= -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Collapsed industrial building</uri>
      <name>target_facility</name>
      <pose>109 -15 0 0 0 0.3</pose>
    </include>
    <!-- target cordon: red/white ring r 16 m around the facility + floating objective marker 27 m above it -->
    <model name='target_marker'><static>true</static><pose>109 -15 0 0 0 0</pose><link name='link'><visual name='ring0'><pose>15.92 1.57 0.35 0 0 1.6690</pose><geometry><box><size>3.20 0.45 0.7</size></box></geometry><material><diffuse>0.85 0.08 0.08 1</diffuse><ambient>0.85 0.08 0.08 1</ambient><emissive>0.45 0.02 0.02 1</emissive></material></visual><visual name='ring1'><pose>15.31 4.64 0.35 0 0 1.8653</pose><geometry><box><size>3.20 0.45 0.7</size></box></geometry><material><diffuse>0.95 0.95 0.95 1</diffuse><ambient>0.95 0.95 0.95 1</ambient><emissive>0.30 0.30 0.30 1</emissive></material></visual><visual name='ring2'><pose>14.11 7.54 0.35 0 0 2.0617</pose><geometry><box><size>3.20 0.45 0.7</size></box></geometry><material><diffuse>0.85 0.08 0.08 1</diffuse><ambient>0.85 0.08 0.08 1</ambient><emissive>0.45 0.02 0.02 1</emissive></material></visual><visual name='ring3'><pose>12.37 10.15 0.35 0 0 2.2580</pose><geometry><box><size>3.20 0.45 0.7</size></box></geometry><material><diffuse>0.95 0.95 0.95 1</diffuse><ambient>0.95 0.95 0.95 1</ambient><emissive>0.30 0.30 0.30 1</emissive></material></visual><visual name='ring4'><pose>10.15 12.37 0.35 0 0 2.4544</pose><geometry><box><size>3.20 0.45 0.7</size></box></geometry><material><diffuse>0.85 0.08 0.08 1</diffuse><ambient>0.85 0.08 0.08 1</ambient><emissive>0.45 0.02 0.02 1</emissive></material></visual><visual name='ring5'><pose>7.54 14.11 0.35 0 0 2.6507</pose><geometry><box><size>3.20 0.45 0.7</size></box></geometry><material><diffuse>0.95 0.95 0.95 1</diffuse><ambient>0.95 0.95 0.95 1</ambient><emissive>0.30 0.30 0.30 1</emissive></material></visual><visual name='ring6'><pose>4.64 15.31 0.35 0 0 2.8471</pose><geometry><box><size>3.20 0.45 0.7</size></box></geometry><material><diffuse>0.85 0.08 0.08 1</diffuse><ambient>0.85 0.08 0.08 1</ambient><emissive>0.45 0.02 0.02 1</emissive></material></visual><visual name='ring7'><pose>1.57 15.92 0.35 0 0 3.0434</pose><geometry><box><size>3.20 0.45 0.7</size></box></geome